# HITCHINGS Documentos — Variables de entorno del frontend (desarrollo local)
#
# Para desarrollo local:
#   Copiar este archivo a .env.local y ajustar según sea necesario.
#
# Para producción:
#   VITE_API_BASE_URL debe quedar vacío (o no definido).
#   Las peticiones /api/... irán al mismo origen vía proxy Nginx.

# URL base del backend FastAPI (solo necesaria en desarrollo local)
VITE_API_BASE_URL=http://localhost:8000
