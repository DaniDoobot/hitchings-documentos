# Application Environment (development, staging, production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Google Gemini API Configuration (no Vertex AI, direct API key)
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_ANALYSIS_THINKING_LEVEL=medium
GEMINI_TIMEOUT_SECONDS=300
GEMINI_MAX_RETRIES=2

# Processing Limits
MAX_DOCUMENT_SIZE_MB=25
MAX_AUDIO_SIZE_MB=200
MAX_TEXT_CHARACTERS=5000000
MAX_ANALYSIS_INPUT_TOKENS=900000
MAX_EXPORT_CHARACTERS=2000000

# CORS Configuration (comma-separated origins allowed to access the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database Configuration (PostgreSQL in production/Docker, SQLite in dev if desired)
DATABASE_URL=postgresql+psycopg://hitchings_app:your_password_here@localhost:5432/hitchings_docs
POSTGRES_DB=hitchings_docs
POSTGRES_USER=hitchings_app
POSTGRES_PASSWORD=your_password_here

# Session Configuration
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24


