# ============================================================
# HITCHINGS Documentos — Variables de entorno para PRODUCCIÓN
# ============================================================
# Copiar este archivo a .env (o inyectar directamente en
# el entorno del host / Dokploy) y rellenar TODOS los valores.
#
# NUNCA subir este archivo con valores reales al repositorio.
# ============================================================

# ---- Aplicación ----
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- Gemini API (OBLIGATORIO) ----
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_ANALYSIS_THINKING_LEVEL=medium
GEMINI_TIMEOUT_SECONDS=300
GEMINI_MAX_RETRIES=2

# ---- Límites de procesamiento ----
MAX_DOCUMENT_SIZE_MB=25
MAX_AUDIO_SIZE_MB=200
MAX_TEXT_CHARACTERS=5000000
MAX_ANALYSIS_INPUT_TOKENS=900000
MAX_EXPORT_CHARACTERS=2000000

# ---- CORS (dejar vacío en producción same-origin) ----
CORS_ALLOWED_ORIGINS=

# ---- Base de Datos PostgreSQL 16 (OBLIGATORIO) ----
POSTGRES_DB=hitchings_docs
POSTGRES_USER=hitchings_app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://hitchings_app:CHANGE_ME_PASSWORD@postgres:5432/hitchings_docs

# ---- Sesiones y Seguridad de Cookies ----
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=24
SESSION_SECRET_KEY=


